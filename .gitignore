__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
*.log
node_modules/
tmp/
# Optional historical report-authoring scripts depend on a local private bundle.
scripts/build_database_system_overview.mjs
scripts/build_variable_data_summary.mjs

# Publish named reference documents; exclude previews and temporary QA files.
outputs/**
!outputs/reference_workbooks/
!outputs/reference_workbooks/housing_database_overview_2026-08-24.xlsx
!outputs/reference_workbooks/housing_database_overview_2026-08-24_base.xlsx
!outputs/reference_workbooks/housing_finance_versions_comparison_2026-08-24.xlsx
!outputs/reference_workbooks/housing_variables_source_limited_legacy_251_ids_2026-08-07.xlsx
!outputs/reference_workbooks/housing_variables_source_limited_2026-08-07.xlsx
!outputs/reference_workbooks/housing_variables_source_limited_2026-08-10.xlsx
!outputs/mentor_reports/
!outputs/mentor_reports/msa_variables_and_geography_alternatives.docx

# Raw and generated data are reproducible artifacts, not source.
data/raw/**
!data/raw/**/.gitkeep
data/archive/deprecated_zori_nsa/*
!data/archive/deprecated_zori_nsa/archive_manifest.csv
data/interim/**
!data/interim/.gitkeep
data/clean/**
!data/clean/.gitkeep
data/benchmark/**
!data/benchmark/**/.gitkeep
data/final/**
!data/final/.gitkeep
# Licensed/restricted snapshots stay inside the project workspace but never enter Git.
data/restricted/**
!data/restricted/**/.gitkeep
database/*.duckdb
database/*.wal
output/**
!output/exports/
!output/exports/variable_dictionary.csv
metadata/pipeline_run_log.csv
metadata/raw_file_manifest.csv
metadata/version_a_raw_file_manifest.csv
metadata/manual_downloads.csv
metadata/version_a_pipeline_run_log.csv
