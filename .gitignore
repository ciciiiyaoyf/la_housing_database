__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
*.log
node_modules/
tmp/
# Optional historical report-authoring scripts depend on a local private bundle.
scripts/build_database_system_overview.mjs
scripts/build_variable_data_summary.mjs
scripts/report_authoring/soffice.exe

# Retired presentation folder; generated reports now belong under output/.
outputs/

# Raw and generated data are reproducible artifacts, not source.
data/raw/**
!data/raw/**/.gitkeep
data/archive/deprecated_zori_nsa/*
!data/archive/deprecated_zori_nsa/archive_manifest.csv
data/interim/**
!data/interim/.gitkeep
data/clean/**
!data/clean/.gitkeep
data/benchmark/**
!data/benchmark/**/.gitkeep
data/final/**
!data/final/.gitkeep
# Licensed/restricted snapshots stay inside the project workspace but never enter Git.
data/restricted/**
!data/restricted/**/.gitkeep
database/*.duckdb
database/*.wal
output/**
!output/README.md
!output/exports/
!output/exports/variable_dictionary.csv
# The reviewed Week 1 submission is shared. Row-level source extracts stay local.
!output/forecasting/
!output/forecasting/week1/
!output/forecasting/week1/week1_memo.pdf
!output/forecasting/week1/*_forecasts.svg
!output/forecasting/week1/accuracy.csv
!output/forecasting/week1/selections.csv
!output/forecasting/week1/regressions.csv
!output/forecasting/week1/forecasts.csv
!output/forecasting/week1/inventory.csv
!output/forecasting/week1/transformation_log.csv
metadata/pipeline_run_log.csv
metadata/raw_file_manifest.csv
metadata/version_a_raw_file_manifest.csv
metadata/manual_downloads.csv
metadata/version_a_pipeline_run_log.csv
