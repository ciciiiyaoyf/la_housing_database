__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.codex-venv/
venv/
.env
*.log

# Raw and generated data are reproducible artifacts, not source.
data/raw/**
!data/raw/**/.gitkeep
data/archive/deprecated_zori_nsa/*
!data/archive/deprecated_zori_nsa/archive_manifest.csv
data/interim/**
!data/interim/.gitkeep
data/clean/**
!data/clean/.gitkeep
data/benchmark/**
!data/benchmark/**/.gitkeep
data/final/**
!data/final/.gitkeep
# Licensed/restricted snapshots stay inside the project workspace but never enter Git.
data/restricted/**
!data/restricted/**/.gitkeep
database/*.duckdb
database/*.wal
output/qa/*.csv
output/coverage/*.csv
output/exports/*.csv
metadata/pipeline_run_log.csv
metadata/raw_file_manifest.csv
metadata/version_a_raw_file_manifest.csv
metadata/manual_downloads.csv
metadata/version_a_pipeline_run_log.csv
